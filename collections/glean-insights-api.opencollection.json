{
  "opencollection": "1.0.0",
  "info": {
    "name": "Glean Client REST activity insights API",
    "version": "0.9.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "insights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve insights and analytics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}-be.glean.com/rest/api/v1/insights"
          },
          "docs": "Retrieve insights and analytics"
        }
      ]
    }
  ],
  "bundled": true
}